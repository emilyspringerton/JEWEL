# JupyterLab serving the JEWEL (PARENA) kernel -- user-level systemd unit (no sudo required).
#
# Deployed 2026-08-26: founder's own chain -- "work on our parena JUPYTER backend just use basic
# auth to protect it for now until we get google oauthg to work" -> "call it JEWEL" -> ... -> "set
# up a single nginx proxy" -> "use fatbaby proxy broker to manage proxies instead of always asking
# for a new feature". Bound to 127.0.0.1 only, reachable ONLY through the fatbaby-broker
# (127.0.0.1:8679, PRRJECT_FATBABY/broker) -- the broker is what actually enforces the Basic Auth
# the founder asked for (real bcrypt check, broker/middleware.go's checkBasicAuth), config-driven
# via gpt2-alpine-c/config/broker-routes.json's "jewel-jupyter" route. nginx is a dumb pass-through
# to the broker (see OKEMILY/ops/nginx-okemily.conf's /jewel/ location), not the auth gate itself.
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/jewel-jupyter.service ~/.config/systemd/user/
#   /home/fatbaby/.venvs/jupyter/bin/python /home/fatbaby/JEWEL/install_kernel.py
#   systemctl --user daemon-reload
#   systemctl --user enable --now jewel-jupyter.service
#
# NOTE: --ServerApp.token='' --ServerApp.password='' disables Jupyter's own built-in token/password
# gate -- deliberate, since the broker's Basic Auth in front of this is the real gate. --ServerApp.
# allow_origin='*' relaxes Jupyter's own websocket same-origin check (Origin vs Host) for the same
# reason -- the broker legitimately rewrites the Host header when relaying to this upstream
# (ProxyHandler.handleUpgrade sets outReq.Host = upstream host:port), which otherwise makes every
# real websocket connection fail Jupyter's own check_origin with "Cross origin websockets not
# allowed" even for a genuine, Basic-Auth-passed request (found and fixed 2026-08-26 verifying a
# real jupyter_client end-to-end round trip through the broker). This unit must stay bound to
# 127.0.0.1 for the "broker is the real gate" tradeoff to be safe -- never change --ip without
# also reintroducing a real auth gate here.

[Unit]
Description=JupyterLab (JEWEL -- real PARENA notebook kernel)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/JEWEL
ExecStart=/home/fatbaby/.venvs/jupyter/bin/jupyter lab \
    --ip=127.0.0.1 --port=8890 --no-browser \
    --ServerApp.token='' --ServerApp.password='' \
    --ServerApp.allow_origin='*' \
    --ServerApp.base_url=/jewel/ \
    --ServerApp.root_dir=/home/fatbaby/JEWEL
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/fatbaby/EMILY/var/logs/jewel-jupyter.log
StandardError=append:/home/fatbaby/EMILY/var/logs/jewel-jupyter.log
MemoryMax=512M

[Install]
WantedBy=default.target
